{
  "manifest_version": 3,
  "name": "Job Scanner",
  "version": "1.0.0",
  "description": "Analyze job postings against your resume with AI and track applications",
  "permissions": ["activeTab", "storage"],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Job Scanner"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["connections-parser.js", "content.js"],
      "css": ["content.css"]
    },
    {
      "matches": ["*://*.linkedin.com/*"],
      "js": ["inject.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
