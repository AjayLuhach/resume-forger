{
  "name": "resume-forge",
  "version": "1.0.0",
  "description": "Single-user job-search toolkit: tailor a resume to a job description, draft outreach from LinkedIn hiring posts, and triage scanned jobs. Bring your own AI key and MongoDB.",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "web": "node server.js",
    "web:local": "MONGO_URI=mongodb://127.0.0.1:27017 MONGO_DB=forge_local node server.js",
    "seed:local": "node scripts/seed-local-from-remote.js",
    "install-pdf": "sudo apt install -y libreoffice-writer && echo '✅ LibreOffice installed! PDF conversion ready.'",
    "ensure-indexes": "node scripts/ensure-indexes.js",
    "models": "node scripts/list-bedrock-models.js",
    "feed:emails:redraft": "node scripts/feed/feed-cli.js emails --redraft",
    "feed:send": "node scripts/feed/send-emails.js",
    "feed:send:verify": "node scripts/feed/send-emails.js --verify",
    "feed:send:list": "node scripts/feed/send-emails.js --list"
  },
  "keywords": [
    "resume",
    "ai",
    "cli",
    "job-search"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-bedrock": "^3.984.0",
    "@aws-sdk/client-bedrock-runtime": "^3.984.0",
    "@google/generative-ai": "^0.21.0",
    "cheerio": "^1.0.0-rc.12",
    "clipboardy": "^4.0.0",
    "docx": "^9.0.2",
    "docxtemplater": "^3.50.0",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "imap": "^0.8.19",
    "mailparser": "^3.9.15",
    "mammoth": "^1.11.0",
    "mongodb": "^6.21.0",
    "nodemailer": "^8.0.1",
    "pdf-lib": "^1.17.1",
    "pizzip": "^3.1.7",
    "puppeteer-core": "^24.39.1"
  }
}
