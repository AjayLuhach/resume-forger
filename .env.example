# Copy to .env and fill in. Only infrastructure lives here — WHO you are is
# the single document in the `users` collection (created on /setup), never
# an env var. SMTP credentials are set per user under /settings. Other
# people's MongoDB connection strings (Settings → Shared job sources) live in
# data/peers.json, which is gitignored — not here, and never in the database.

# ============================================================
# SERVER
# ============================================================
# Port the web UI listens on. The browser extension defaults to 5003; if you
# change this, set the same number under "Server port" in the extension's
# popup (no manifest edit, no reload).
PORT=5003

# Interface to bind. Loopback by default: /api/setup (until the first user
# exists) and the extension's /api/ext/* routes answer without a session, so
# exposing the LAN is a deliberate choice, not a default.
# HOST=0.0.0.0  # expose on the LAN — /api/ext has no auth

# Signing key for session cookies. Generate one: `openssl rand -hex 32`
# Leave blank and a random key is used per boot (every restart logs you out).
SESSION_SECRET=


# Where tailored resumes are written. Leave blank for the default,
# ~/Downloads/resume-forge (created on first use). Absolute paths and `~` work;
# a relative path resolves from the repo root. Batch-tailored PDFs go into
# a-tailored-resumes/ underneath it.
OUTPUT_DIR=

# ============================================================
# MONGODB
# ============================================================
# Any MongoDB 6+ — Atlas free tier or a local mongod both work.
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/?retryWrites=true&w=majority
MONGO_DB=resume_forge

# ============================================================
# AI PROVIDER
# ============================================================
# 'bedrock' | 'gemini' — also switchable per-run in the UI dropdown
AI_PROVIDER=bedrock

# ---- AWS Bedrock (AI_PROVIDER=bedrock) ----
# Two transports, picked by BEDROCK_TRANSPORT ('aws' | 'mantle'). Leave it
# blank to infer: BEDROCK_API_KEY set -> mantle, otherwise aws.
BEDROCK_TRANSPORT=

# 'aws' transport — SigV4 with the standard AWS credential chain (these two,
# or AWS_PROFILE / a role). AWS_REGION is the region the Converse API is
# called in; model access is granted per region in the Bedrock console.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# 'mantle' transport — Bedrock's OpenAI-compatible endpoint, authenticated
# with a bearer API key instead of IAM credentials.
#
# Pick the region NEAREST to you: every request pays the round trip, and a
# faster model in a far region can lose to a slower one nearby. The model
# CATALOGUE also differs per region — a model that exists in us-east-1 may
# 404 in eu-west-1. List what your region offers with `npm run models`
# before choosing the model IDs below.
#   https://bedrock-mantle.<region>.api.aws/v1
BEDROCK_BASE_URL=https://bedrock-mantle.us-east-1.api.aws/v1
BEDROCK_API_KEY=

# Tailor model: alias ('deepseek', 'mistral', 'glm', 'qwen', 'gemma', …) or a
# full model ID from `npm run models`.
BEDROCK_MODEL=deepseek
# Feed (outreach) pipeline model — cheap and fast matters more than depth here.
BEDROCK_MODEL_ID=google.gemma-3-27b-it
# Job scanner model: alias or full ID.
SCANNER_MODEL_ID=gemma
# Model used by the tailor's "ats_max" mode.
ATS_MAX_MODEL=mistral

# ---- Google Gemini (AI_PROVIDER=gemini) ----
# Free tier with rate limits. Get a key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ============================================================
# PDF RENDERING (optional)
# ============================================================
# Tailored PDFs are typeset in Chrome (puppeteer-core). Chrome/Chromium is
# auto-detected; set this if it lives somewhere unusual.
# CHROME_PATH=/usr/bin/google-chrome
# Force the DOCX + LibreOffice fallback instead of Chrome (`npm run install-pdf`).
# RESUME_RENDERER=docx

# ============================================================
# EMAIL SENDING (optional, debug)
# ============================================================
# When 'true', every outreach email is redirected to EMAIL_TEST_INBOX instead
# of the real recipient. Use it to check SMTP and the drafts before sending
# for real. EMAIL_TEST_INBOX is required when test mode is on.
EMAIL_TEST_MODE=false
EMAIL_TEST_INBOX=
